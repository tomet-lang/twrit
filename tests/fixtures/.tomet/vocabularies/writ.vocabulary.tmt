::kind(vocabulary)
::vocabulary(writ){
  version: "1.0.0"
}

::elements{
  rule: {
    display: block
    singleton: false
    about: | 一つの規則。パラメータは自分の group の中に持つ。
           |
           | 以前は規則がエントリではなく**配置**だった。`id / rule / why / guard` は
           | 二本の水平線に対する位置でしかなく、`@layers` や `@pure` はトップレベルに
           | 浮いて誰にも所有されていなかった。だから空行が一つ落ちただけで
           | `crate-layering` の宣言が段落に吸収され、`twrit` は何も読まないまま
           | `ok` と言い続けた。group の中にあれば、閉じ忘れはパースエラーになる。
           |
           | `guard:` は必須。誰がこの規則を今保証しているかだけを答える。値は
           | `{ twrit: kind }`（twrit が実装する種類）、`{ runs: "コマンド" }`（
           | リポジトリが持つランナー。twrit は走らせず、誰が走らせるかを記録する）、
           | `{ test: "パス" }`（このリポジトリのテスト。twrit はパスの実在だけ見る）、
           | `{ none: "理由" }`（今は誰も保証していない）のいずれか。
           |
           | `none:` に理由を要求し、`guard:` の欠落をエラーにするのは、「誰も
           | 保証していない」と「書き忘れた」を同じ見た目にしないため。両者が
           | 見分けられなくなるのは、`ok` が「守られている」と「一度も読まれて
           | いない」を兼ねていたのと同じ病気である。
           |
           | guard はポインタであって、プログラムではない。エントリにシェル行を
           | 埋め込む案は却下された。それは散文をまとった Makefile であり、
           | `.writ.tmt` を読むだけで任意のコマンドが走りうることになる。
    args: {
      id: {
        type: string
        positional: true
        about: | 規則の識別子。見出しではなくここが名前である。見出しは散文で、
               | 書き換えられる。
      }
    }
  }
}
