::kind(writ)

=[ Writ: all-rust-guards fixture ]

==[ crate-layering ]

@rule(rule-layers){
  guard: ( twrit: layers )

  layers: (
    0: ("core")
  )
}

==[ file-io ]

@rule(rule-door){
  guard: ( twrit: door )

  door: (
    names: ("std::fs")
    allowed: ("core")
  )
}

==[ parser-purity ]

@rule(rule-pure){
  guard: ( twrit: pure )

  pure: (
    crates: ("core")
    forbid: ("std::process")
    allow-external: ()
  )
}

==[ rust-api ]

@rule(rule-api){
  guard: ( twrit: rust-api )
  rust_api: (
    out: "docs/crates"
  )
}
