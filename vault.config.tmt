::kind(config)
::id(config-vault)
::macro(
  copyright: ("(C) 2026 Tomet Projects")
  generated_by: [@comment[ Generated from $(1). Edit that, then `tomet export .`. ]]
)
::vocabulary(
  writ: @file(.tomet/vocabularies/writ.vocabulary.tmt)
)
::format(
  meta: ( always_newline: true )
  section: ( space_inside_brackets: true )
  list: ( multiline: ( style: ( content: box ) ) )
  element: (
    table:   ( adjust_width: auto, max_col_width: 50 )
    link:    ( no_space: true, group_order: "[]()" )
    quote:   ( always_newline: true )
    callout: ( style: ( content: block ) )
  )
)
::workspace(
  unswept: ( "tests/fixtures", "tests/ref", "tests/store" )
)
